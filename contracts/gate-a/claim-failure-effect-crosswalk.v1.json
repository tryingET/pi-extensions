  "schema": "ai-society.claim-failure-effect-crosswalk/1",
  "semantic_rule": "This crosswalk aligns shared meanings while each owner retains local codes and authority. It is not a global enum or a semantic-ownership transfer. Expiry is a known authorization denial and is not revocation.",
  "status": "candidate_integration_owner_acceptance_pending",
  "terms": [
    {
      "meaning": "A source or intent claims a value; no resolution or authority is implied.",
      "term": "declared"
    },
    {
      "meaning": "Exact source and resource references were selected.",
      "term": "resolved"
    },
    {
      "meaning": "An executable/materialized artifact was produced with its own identity.",
      "term": "built"
    },
    {
      "meaning": "A runtime/effect surface was measured, without asserting expected equality.",
      "term": "observed"
    },
    {
      "meaning": "Evidence was checked against a named rule; verifier is not approver.",
      "term": "verified"
    },
    {
      "meaning": "A named owner accepted a contract or release through its process.",
      "term": "accepted"
    },
    {
      "meaning": "A current task-bound permit authorizes a bounded run/effect class.",
      "term": "authorized"
    },
    {
      "meaning": "The accountable effect owner accepted the terminal effect disposition.",
      "term": "settled"
    },
    {
      "meaning": "Required evidence is missing, expired, or the observer cannot establish the claim.",
      "term": "unproven"
    },
    {
      "meaning": "Expected and observed identities or surfaces differ.",
      "term": "mismatch"
    },
    {
      "meaning": "Previously usable authority/trust was withdrawn by its owner.",
      "term": "revoked"
    },
    {
      "meaning": "Effects may have occurred and cannot yet be settled.",
      "term": "effect_indeterminate"
    },
    {
      "meaning": "The effect custodian established that no external effects occurred.",
      "term": "confirmed_no_effects"
    },
    {
      "meaning": "Retained for history but not launch eligible.",
      "term": "historical_only"
    },
    {
      "meaning": "Retained under incident/legal custody and not launch eligible.",
      "term": "forensic_only"
    }
  ]
