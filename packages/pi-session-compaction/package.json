{
  "name": "@tryinget/pi-session-compaction",
  "version": "0.1.0",
  "description": "Dedicated Pi package for custom session compaction summaries.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/pi-extensions.git",
    "directory": "packages/pi-session-compaction"
  },
  "bugs": {
    "url": "https://github.com/tryingET/pi-extensions/issues"
  },
  "homepage": "https://github.com/tryingET/pi-extensions/tree/main/packages/pi-session-compaction",
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "session-summary"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fix": "bash ../../scripts/package-quality-gate.sh fix .",
    "lint": "bash ../../scripts/package-quality-gate.sh lint .",
    "typecheck": "bash ../../scripts/package-quality-gate.sh typecheck .",
    "test": "bash ../../scripts/package-quality-gate.sh test .",
    "quality:pre-commit": "bash ../../scripts/package-quality-gate.sh pre-commit .",
    "quality:pre-push": "bash ../../scripts/package-quality-gate.sh pre-push .",
    "quality:ci": "bash ../../scripts/package-quality-gate.sh ci .",
    "check": "npm run quality:ci",
    "prepack": "node ../pi-interaction/scripts/prepare-publish-manifest.mjs prepack",
    "postpack": "node ../pi-interaction/scripts/prepare-publish-manifest.mjs postpack",
    "release:check": "npm pack --dry-run --json",
    "release:check:quick": "npm pack --dry-run --json"
  },
  "files": [
    "extensions",
    "docs",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/session-compaction.js"
    ]
  },
  "exports": {
    "./branch-summary": "./extensions/session-compaction/branch-summary.js",
    "./files-touched": "./extensions/session-compaction/files-touched.js",
    "./handler": "./extensions/session-compaction/handler.js",
    "./model-resolver": "./extensions/session-compaction/model-resolver.js",
    "./registration": "./extensions/session-compaction/registration.js",
    "./user-prompts": "./extensions/session-compaction/user-prompts.js"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.65.2",
    "@tryinget/pi-model-selection": "file:../pi-model-selection"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "typebox": "^1.0.0"
  },
  "x-pi-template": {
    "scaffoldMode": "simple-package",
    "workspacePath": "packages/pi-session-compaction",
    "releaseComponent": "pi-session-compaction",
    "releaseConfigMode": "component"
  }
}
