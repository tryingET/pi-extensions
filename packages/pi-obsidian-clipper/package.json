{
  "name": "@tryinget/pi-obsidian-clipper",
  "version": "0.2.0",
  "description": "Native Obsidian Clipper capture and read-only workstation Interpreter setup for Pi",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/pi-extensions.git",
    "directory": "packages/pi-obsidian-clipper"
  },
  "bugs": {
    "url": "https://github.com/tryingET/pi-extensions/issues"
  },
  "homepage": "https://github.com/tryingET/pi-extensions/tree/main/packages/pi-obsidian-clipper",
  "keywords": [
    "pi-package",
    "pi-extension",
    "obsidian-clipper",
    "monorepo"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fix": "bash ./scripts/quality-gate.sh fix",
    "lint": "bash ./scripts/quality-gate.sh lint",
    "typecheck": "bash ./scripts/quality-gate.sh typecheck",
    "quality:pre-commit": "bash ./scripts/quality-gate.sh pre-commit",
    "quality:pre-push": "bash ./scripts/quality-gate.sh pre-push",
    "quality:ci": "bash ./scripts/quality-gate.sh ci",
    "check": "npm run quality:ci",
    "test": "npm run quality:ci",
    "docs:list": "node ~/ai-society/core/agent-scripts/scripts/docs-list.mjs",
    "docs:list:workspace": "node ~/ai-society/core/agent-scripts/scripts/docs-list.mjs --workspace --discover",
    "docs:list:json": "node ~/ai-society/core/agent-scripts/scripts/docs-list.mjs --json",
    "release:check": "bash ./scripts/release-check.sh",
    "release:check:quick": "SKIP_PI_SMOKE=1 bash ./scripts/release-check.sh"
  },
  "files": [
    "extensions/obsidian-clipper.ts",
    "src",
    "docs/project/native-engine.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/obsidian-clipper.ts"
    ]
  },
  "x-pi-template": {
    "scaffoldMode": "simple-package",
    "workspacePath": "packages/pi-obsidian-clipper",
    "releaseComponent": "pi-obsidian-clipper",
    "releaseConfigMode": "component",
    "piHostContract": {
      "schemaVersion": 1,
      "source": "@tryinget/pi-extensions-package-template",
      "packageVersionSource": "package.json#version",
      "hostBaseline": "1.1.0",
      "devTestFloor": "1.1.0",
      "peerCompatibility": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-ai": "*"
      }
    }
  },
  "dependencies": {
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.19.15",
    "tsx": "4.23.15",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "overrides": {
    "fast-xml-parser": "5.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  }
}
