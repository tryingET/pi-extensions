+import { describe, expect, test } from 'vitest';
+import {
+	collectInterpreterImages,
+	extractImageUrls,
+	fetchImageAsDataUrl,
+	MAX_INTERPRETER_IMAGE_BYTES,
+	providerSupportsImageParts,
+	shouldSendImages,
+} from './interpreter-images';
+import { ModelConfig, Provider } from '../types/types';
+
+const provider = (name: string, baseUrl = 'http://127.0.0.1:1234/v1/chat/completions'): Provider => ({
+	id: 'p', name, baseUrl, apiKey: 'k', apiKeyRequired: true,
+});
+const model = (sendImages?: boolean): ModelConfig => ({
+	id: 'm', providerId: 'p', providerModelId: 'x', name: 'x', enabled: true, ...(sendImages === undefined ? {} : { sendImages }),
+});
+const png = (bytes = 64) => new Uint8Array(bytes).fill(7);
+const response = (body: Uint8Array, type = 'image/png', status = 200) =>
+	new Response(body, { status, headers: { 'content-type': type, 'content-length': String(body.byteLength) } });
+
+describe('interpreter images', () => {
+	test('extracts http(s) image URLs in order, deduplicated, skipping svg and data URLs', () => {
+		const md = [
+			'![a](https://example.com/a.png)',
+			'text ![b](https://example.com/b.jpg "title") more',
+			'![dup](https://example.com/a.png)',
+			'![svg](https://example.com/logo.svg)',
+			'![data](data:image/png;base64,AAAA)',
+			'![rel](img/relative.png)',
+			'[not an image](https://example.com/c.png)'
+		].join('\n');
+		expect(extractImageUrls(md)).toEqual(['https://example.com/a.png', 'https://example.com/b.jpg']);
+	});
+
+	test('only the default OpenAI-compatible format carries image parts, and only when opted in', () => {
+		expect(providerSupportsImageParts(provider('Workstation'))).toBe(true);
+		expect(providerSupportsImageParts(provider('OpenAI', 'https://api.openai.com/v1/chat/completions'))).toBe(true);
+		for (const name of ['Anthropic', 'Ollama', 'Perplexity', 'DeepSeek', 'Hugging Face']) {
+			expect(providerSupportsImageParts(provider(name))).toBe(false);
+		}
+		expect(providerSupportsImageParts(provider('Gemini', 'https://generativelanguage.googleapis.com/v1beta'))).toBe(false);
+		expect(providerSupportsImageParts(provider('Azure', 'https://x.openai.azure.com/openai'))).toBe(false);
+		expect(shouldSendImages(model(), provider('Workstation'))).toBe(false);
+		expect(shouldSendImages(model(false), provider('Workstation'))).toBe(false);
+		expect(shouldSendImages(model(true), provider('Workstation'))).toBe(true);
+		expect(shouldSendImages(model(true), provider('Anthropic'))).toBe(false);
+	});
+
+	test('fetches as a data URL without credentials and enforces type and size limits', async () => {
+		let init: RequestInit | undefined;
+		const ok = await fetchImageAsDataUrl('https://example.com/a.png', (async (_u: any, i?: RequestInit) => { init = i; return response(png(3)); }) as typeof fetch);
+		expect(ok).toBe(`data:image/png;base64,${btoa(String.fromCharCode(7, 7, 7))}`);
+		expect(init?.credentials).toBe('omit');
+		await expect(fetchImageAsDataUrl('u', (async () => response(png(), 'image/svg+xml')) as typeof fetch)).rejects.toThrow('unsupported type');
+		await expect(fetchImageAsDataUrl('u', (async () => response(png(), 'text/html')) as typeof fetch)).rejects.toThrow('unsupported type');
+		await expect(fetchImageAsDataUrl('u', (async () => response(png(), 'image/png', 404)) as typeof fetch)).rejects.toThrow('HTTP 404');
+		await expect(fetchImageAsDataUrl('u', (async () => response(new Uint8Array(MAX_INTERPRETER_IMAGE_BYTES + 1))) as typeof fetch)).rejects.toThrow('too large');
+	});
+
+	test('collects at most four images and records skipped ones', async () => {
+		const urls = Array.from({ length: 7 }, (_, i) => `https://example.com/${i}.png`);
+		const md = urls.map(u => `![](${u})`).join('\n');
+		const fetchImpl = (async (u: any) => (String(u).endsWith('/1.png') ? response(png(), 'text/html') : response(png()))) as typeof fetch;
+		const result = await collectInterpreterImages(md, fetchImpl);
+		expect(result.images).toHaveLength(4);
+		expect(result.skipped).toEqual([{ url: 'https://example.com/1.png', reason: 'unsupported type text/html' }]);
+	});
+});
