+import { ModelConfig, Provider } from '../types/types';
+
+// Opt-in page images for Interpreter requests.
+// Images are fetched by the extension itself and sent as base64 data URLs, so the
+// model endpoint never has to fetch arbitrary web URLs.
+
+export const MAX_INTERPRETER_IMAGES = 4;
+export const MAX_INTERPRETER_IMAGE_BYTES = 2 * 1024 * 1024;
+export const MIN_INTERPRETER_IMAGE_DIMENSION = 16;
+const MAX_CANDIDATES = 16;
+const ALLOWED_IMAGE_TYPES = ['image/png', 'image/jpeg', 'image/webp', 'image/gif'];
+
+export interface InterpreterImageResult {
+	images: string[];
+	skipped: { url: string; reason: string }[];
+}
+
+// Only the default OpenAI-compatible request format carries image parts.
+// Providers with their own request formats stay text-only.
+export function providerSupportsImageParts(provider: Provider): boolean {
+	const name = provider.name.toLowerCase();
+	const baseUrl = provider.baseUrl;
+	return !(
+		name.includes('hugging') ||
+		baseUrl.includes('openai.azure.com') ||
+		name.includes('deepseek') ||
+		baseUrl.includes('generativelanguage.googleapis.com') ||
+		name.includes('anthropic') ||
+		name.includes('perplexity') ||
+		name.includes('ollama')
+	);
+}
+
+export function shouldSendImages(model: ModelConfig, provider: Provider): boolean {
+	return model.sendImages === true && providerSupportsImageParts(provider);
+}
+
+// Image URLs from Markdown image syntax, in document order, deduplicated.
+// Skips non-http(s) URLs (including data: URLs) and SVG files.
+export function extractImageUrls(markdown: string, limit: number = MAX_CANDIDATES): string[] {
+	const urls: string[] = [];
+	const pattern = /!\[[^\]]*\]\(\s*<?([^)\s>]+)>?(?:\s+"[^"]*")?\s*\)/g;
+	let match: RegExpExecArray | null;
+	while ((match = pattern.exec(markdown)) !== null && urls.length < limit) {
+		const raw = match[1];
+		let url: URL;
+		try {
+			url = new URL(raw);
+		} catch {
+			continue;
+		}
+		if (url.protocol !== 'http:' && url.protocol !== 'https:') continue;
+		if (url.pathname.toLowerCase().endsWith('.svg')) continue;
+		const href = url.href;
+		if (!urls.includes(href)) urls.push(href);
+	}
+	return urls;
+}
+
+function toBase64(bytes: Uint8Array): string {
+	let binary = '';
+	const chunk = 0x8000;
+	for (let i = 0; i < bytes.length; i += chunk) {
+		binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
+	}
+	return btoa(binary);
+}
+
+async function imageDimensions(blob: Blob): Promise<{ width: number; height: number } | null> {
+	if (typeof createImageBitmap !== 'function') return null;
+	const bitmap = await createImageBitmap(blob);
+	const size = { width: bitmap.width, height: bitmap.height };
+	bitmap.close();
+	return size;
+}
+
+export async function fetchImageAsDataUrl(url: string, fetchImpl: typeof fetch = fetch): Promise<string> {
+	const response = await fetchImpl(url, { credentials: 'omit', redirect: 'follow' });
+	if (!response.ok) throw new Error(`HTTP ${response.status}`);
+	const type = (response.headers.get('content-type') || '').split(';')[0].trim().toLowerCase();
+	if (!ALLOWED_IMAGE_TYPES.includes(type)) throw new Error(`unsupported type ${type || 'unknown'}`);
+	const declared = Number(response.headers.get('content-length') || '0');
+	if (declared > MAX_INTERPRETER_IMAGE_BYTES) throw new Error('too large');
+	const buffer = new Uint8Array(await response.arrayBuffer());
+	if (buffer.byteLength > MAX_INTERPRETER_IMAGE_BYTES) throw new Error('too large');
+	const size = await imageDimensions(new Blob([buffer], { type }));
+	if (size && (size.width < MIN_INTERPRETER_IMAGE_DIMENSION || size.height < MIN_INTERPRETER_IMAGE_DIMENSION)) {
+		throw new Error('too small');
+	}
+	return `data:${type};base64,${toBase64(buffer)}`;
+}
+
+export async function collectInterpreterImages(
+	markdown: string,
+	fetchImpl: typeof fetch = fetch,
+	max: number = MAX_INTERPRETER_IMAGES
+): Promise<InterpreterImageResult> {
+	const result: InterpreterImageResult = { images: [], skipped: [] };
+	for (const url of extractImageUrls(markdown)) {
+		if (result.images.length >= max) break;
+		try {
+			result.images.push(await fetchImageAsDataUrl(url, fetchImpl));
+		} catch (error) {
+			result.skipped.push({ url, reason: error instanceof Error ? error.message : String(error) });
+		}
+	}
+	return result;
+}
