{
  "name": "@tryinget/pi-prompt-template-execution",
  "version": "0.1.0",
  "description": "Live prompt-template execution successor for model/thinking/args semantics.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/pi-extensions.git",
    "directory": "packages/pi-prompt-template-execution"
  },
  "bugs": {
    "url": "https://github.com/tryingET/pi-extensions/issues"
  },
  "homepage": "https://github.com/tryingET/pi-extensions/tree/main/packages/pi-prompt-template-execution",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-template",
    "model-selection"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "fix": "bash ../../scripts/package-quality-gate.sh fix .",
    "lint": "bash ../../scripts/package-quality-gate.sh lint .",
    "typecheck": "bash ../../scripts/package-quality-gate.sh typecheck .",
    "test": "bash ../../scripts/package-quality-gate.sh test .",
    "quality:pre-commit": "bash ../../scripts/package-quality-gate.sh pre-commit .",
    "quality:pre-push": "bash ../../scripts/package-quality-gate.sh pre-push .",
    "quality:ci": "bash ../../scripts/package-quality-gate.sh ci .",
    "check": "npm run quality:ci",
    "prepack": "node ../pi-interaction/scripts/prepare-publish-manifest.mjs prepack",
    "postpack": "node ../pi-interaction/scripts/prepare-publish-manifest.mjs postpack",
    "release:check": "npm pack --dry-run --json",
    "release:check:quick": "npm pack --dry-run --json",
    "loop-doctor": "bash -lc 'node --version; npm --version; npm pkg get name version >/dev/null; git status --short -- . || true; exit 0'",
    "loop-verify-fast": "npm run quality:pre-commit",
    "loop-impact-plan": "bash -lc 'echo \"loop-impact-plan: package-local impact planner is coarse; run npm run loop-impact-run for the full package gate.\"; git status --short -- . || true'",
    "loop-impact-run": "npm run check",
    "loop-impact-wide": "npm run check",
    "loop-landing-check": "npm run check"
  },
  "files": [
    "extensions/prompt-template-execution.js",
    "src",
    "docs",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "policy/security-policy.json",
    "policy/engineering-lane.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/prompt-template-execution.js"
    ]
  },
  "exports": {
    "./args": "./src/args.js",
    "./command-runner": "./src/command-runner.js",
    "./compat-canary": "./src/compat-canary.js",
    "./diagnostic-report": "./src/diagnostic-report.js",
    "./execution-plan": "./src/execution-plan.js",
    "./host-adapter": "./src/host-adapter.js",
    "./loader": "./src/loader.js",
    "./model-conditionals": "./src/model-conditionals.js",
    "./safety-report": "./src/safety-report.js",
    "./skills": "./src/skills.js",
    "./registration": "./src/registration.js"
  },
  "x-pi-template": {
    "scaffoldMode": "simple-package",
    "workspacePath": "packages/pi-prompt-template-execution",
    "releaseComponent": "pi-prompt-template-execution",
    "releaseConfigMode": "component"
  },
  "dependencies": {
    "@tryinget/pi-model-selection": "file:../pi-model-selection"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "typebox": "^1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
