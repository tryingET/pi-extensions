{
  "name": "@tryinget/pi-vault-client",
  "version": "0.6.0",
  "description": "pi extension package for vault workflows in monorepo runtime",
  "type": "module",
  "exports": {
    ".": "./extensions/vault.js",
    "./prompt-plane": {
      "types": "./src/promptPlane.d.ts",
      "default": "./src/promptPlane.js"
    },
    "./dispatch-posture": {
      "types": "./src/dispatchPosture.d.ts",
      "default": "./src/dispatchPosture.js"
    },
    "./dispatch-runtime": {
      "types": "./src/dispatchRuntime.d.ts",
      "default": "./src/dispatchRuntime.js"
    },
    "./dispatch-guard": {
      "types": "./src/dispatchGuard.d.ts",
      "default": "./src/dispatchGuard.js"
    },
    "./toolbox-bundle": "./src/toolboxBundle.js"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/pi-extensions.git",
    "directory": "packages/pi-vault-client"
  },
  "bugs": {
    "url": "https://github.com/tryingET/pi-extensions/issues"
  },
  "homepage": "https://github.com/tryingET/pi-extensions/tree/main/packages/pi-vault-client",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vault",
    "monorepo"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "sync:prompt-vault-contract": "node ./scripts/sync-prompt-vault-contract.mjs --write",
    "check:prompt-vault-contract": "node ./scripts/sync-prompt-vault-contract.mjs --check",
    "check:generated-runtime": "node ./scripts/check-generated-runtime-clean.mjs",
    "fix": "bash ./scripts/quality-gate.sh fix",
    "lint": "bash ./scripts/quality-gate.sh lint",
    "typecheck": "bash ./scripts/quality-gate.sh typecheck",
    "quality:pre-commit": "bash ./scripts/quality-gate.sh pre-commit",
    "quality:pre-push": "bash ./scripts/quality-gate.sh pre-push",
    "quality:ci": "bash ./scripts/quality-gate.sh ci",
    "check": "npm run quality:ci",
    "test": "npm run quality:ci",
    "test:compat:live-trigger-contract": "node --test tests/shared-trigger-broker.test.mjs tests/vault-live-trigger-contract.test.mjs tests/vault-query-regression.test.mjs",
    "docs:list": "node ~/ai-society/core/agent-scripts/scripts/docs-list.mjs",
    "docs:list:workspace": "node ~/ai-society/core/agent-scripts/scripts/docs-list.mjs --workspace --discover",
    "docs:list:json": "node ~/ai-society/core/agent-scripts/scripts/docs-list.mjs --json",
    "release:check": "bash ./scripts/release-check.sh",
    "release:check:quick": "SKIP_PI_SMOKE=1 bash ./scripts/release-check.sh",
    "prepack": "node ./scripts/prepare-portable-readme.mjs prepack && node ../pi-interaction/scripts/prepare-publish-manifest.mjs prepack && node ./scripts/build-runtime.mjs --quiet",
    "postpack": "node ../pi-interaction/scripts/prepare-publish-manifest.mjs postpack && node ./scripts/prepare-portable-readme.mjs postpack",
    "loop-doctor": "bash -lc 'node --version; npm --version; npm pkg get name version >/dev/null; git status --short -- . || true; exit 0'",
    "loop-verify-fast": "npm run quality:pre-commit",
    "loop-impact-plan": "bash -lc 'echo \"loop-impact-plan: package-local impact planner is coarse; run npm run loop-impact-run for the full package gate.\"; git status --short -- . || true'",
    "loop-impact-run": "npm run check",
    "loop-impact-wide": "npm run check",
    "loop-landing-check": "npm run check"
  },
  "files": [
    "extensions/vault.js",
    "src",
    "prompts",
    "examples",
    "policy/security-policy.json",
    "policy/engineering-lane.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/vault.js"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "x-pi-template": {
    "scaffoldMode": "simple-package",
    "workspacePath": "packages/pi-vault-client",
    "releaseComponent": "pi-vault-client",
    "releaseConfigMode": "component"
  },
  "dependencies": {
    "@tryinget/pi-interaction-kit": "0.2.0",
    "@tryinget/pi-runtime-registry": "0.2.0",
    "@tryinget/pi-trigger-adapter": "0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260417.1",
    "markdown-it": "^14.1.1",
    "typebox": "1.3.7",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "fast-xml-parser": "5.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
