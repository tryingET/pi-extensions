{
  "name": "@tryinget/pi-session-insights",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic jq-first extraction of bounded insight facts from Pi session JSONL",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/pi-extensions.git",
    "directory": "packages/pi-session-insights"
  },
  "bugs": {
    "url": "https://github.com/tryingET/pi-extensions/issues"
  },
  "homepage": "https://github.com/tryingET/pi-extensions/tree/main/packages/pi-session-insights",
  "keywords": [
    "pi-package",
    "pi-skill",
    "session-jsonl",
    "jq",
    "monorepo"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pi-session-insights": "./bin/pi-session-insights.mjs"
  },
  "scripts": {
    "fix": "bash ./scripts/quality-gate.sh fix",
    "lint": "bash ./scripts/quality-gate.sh lint",
    "typecheck": "bash ./scripts/quality-gate.sh typecheck",
    "fixtures:test": "node --test tests/session-insights.test.mjs",
    "quality:pre-commit": "bash ./scripts/quality-gate.sh pre-commit",
    "quality:pre-push": "bash ./scripts/quality-gate.sh pre-push",
    "quality:ci": "bash ./scripts/quality-gate.sh ci",
    "check": "npm run quality:ci",
    "test": "npm run quality:ci",
    "docs:list": "bash ./scripts/docs-list.sh",
    "docs:list:workspace": "bash ./scripts/docs-list.sh --workspace --discover",
    "docs:list:json": "bash ./scripts/docs-list.sh --json"
  },
  "files": [
    "bin/pi-session-insights.mjs",
    "lib/session-insights.jq",
    "skills",
    "examples",
    "policy/security-policy.json",
    "policy/engineering-lane.json"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "x-pi-template": {
    "scaffoldMode": "simple-package",
    "workspacePath": "packages/pi-session-insights",
    "releaseComponent": "pi-session-insights",
    "releaseConfigMode": "none"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14"
  },
  "overrides": {
    "fast-xml-parser": "5.3.6"
  }
}
