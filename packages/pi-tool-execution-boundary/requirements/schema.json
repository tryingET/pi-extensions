{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryinget.invalid/pi-tool-boundary/requirements-v1.schema.json",
  "title": "pi-tool-boundary-requirements/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "specification_version", "requirements"],
  "properties": {
    "schema": { "const": "pi-tool-boundary-requirements/v1" },
    "specification_version": { "const": "0.3" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "normative_requirement", "threat_or_failure", "design_sections", "primary_verification", "target_release", "status"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
          "normative_requirement": { "type": "string", "minLength": 1 },
          "threat_or_failure": { "type": "string", "minLength": 1 },
          "design_sections": { "type": "string", "minLength": 1 },
          "primary_verification": { "type": "string", "minLength": 1 },
          "target_release": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
