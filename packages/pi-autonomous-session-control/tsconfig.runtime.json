  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "execution.ts",
    "extensions/self/subagent-pi-json-filter.ts",
    "extensions/self/subagent-pi-json-filter-v2.ts",
    "extensions/self/subagent-protocol-v2.ts"
  ]
}
