{
  "name": "@tryinget/pi-autonomous-session-control",
  "version": "0.5.1",
  "description": "pi extension package for autonomy-control workflows in pi",
  "type": "module",
  "exports": {
    ".": "./extensions/self.ts",
    "./execution": "./dist/execution.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/pi-extensions.git",
    "directory": "packages/pi-autonomous-session-control"
  },
  "bugs": {
    "url": "https://github.com/tryingET/pi-extensions/issues"
  },
  "homepage": "https://github.com/tryingET/pi-extensions/tree/main/packages/pi-autonomous-session-control",
  "keywords": [
    "pi-package",
    "pi-extension",
    "autonomy-control"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "fix": "bash ./scripts/quality-gate.sh fix",
    "lint": "bash ./scripts/quality-gate.sh lint",
    "typecheck": "bash ./scripts/quality-gate.sh typecheck",
    "quality:pre-commit": "bash ./scripts/quality-gate.sh pre-commit",
    "quality:pre-push": "bash ./scripts/quality-gate.sh pre-push",
    "quality:ci": "bash ./scripts/quality-gate.sh ci",
    "check": "npm run quality:ci",
    "test": "npm run quality:ci",
    "test:live:prompt-vault": "ASC_RUN_LIVE_PROMPT_VAULT_TESTS=1 node --test tests/prompt-vault-db-integration.live.mjs tests/prompt-vault-cross-extension.live.mjs",
    "test:compat:parallel-tool-events": "node --test tests/self/registration.test.mjs tests/self/perception.test.mjs tests/self/perception-file-budget.test.mjs tests/self/perception-recovery-cues.test.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "prepare": "npm run build:runtime",
    "docs:list": "bash ./scripts/docs-list.sh",
    "docs:list:workspace": "bash ./scripts/docs-list.sh --workspace --discover",
    "docs:list:json": "bash ./scripts/docs-list.sh --json",
    "release:check": "bash ./scripts/release-check.sh",
    "release:check:quick": "SKIP_PI_SMOKE=1 bash ./scripts/release-check.sh"
  },
  "files": [
    "extensions/self.ts",
    "extensions/self",
    "dist",
    "prompts",
    "examples",
    "policy/security-policy.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/self.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "x-pi-template": {
    "scaffoldMode": "monorepo-package",
    "workspacePath": "packages/pi-autonomous-session-control",
    "releaseComponent": "pi-autonomous-session-control",
    "releaseConfigMode": "component"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^25.3.3",
    "@typescript/native-preview": "7.0.0-dev.20260417.1",
    "typebox": "1.3.7"
  },
  "overrides": {
    "fast-xml-parser": "5.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
