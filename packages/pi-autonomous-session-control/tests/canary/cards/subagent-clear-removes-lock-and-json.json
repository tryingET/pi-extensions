{
  "id": "subagent-clear-preserves-lock-and-jsonl-by-default",
  "title": "subagent-clear must preserve tracked .lock + .jsonl session artifacts unless deletion is explicit",
  "target": "subagent_sessions",
  "command": {
    "name": "subagent-clear",
    "args": ""
  },
  "seedFiles": [
    {
      "name": "same.lock",
      "content": "{\"sessionName\":\"same\",\"sessionKind\":\"subagent\"}"
    },
    {
      "name": "same.status.json",
      "content": "{\"sessionName\":\"same\",\"status\":\"done\",\"pid\":1,\"ppid\":1,\"createdAt\":\"2026-05-24T00:00:00.000Z\",\"updatedAt\":\"2026-05-24T00:00:00.000Z\",\"sessionKind\":\"subagent\"}"
    },
    {
      "name": "same.jsonl",
      "content": "{}"
    },
    {
      "name": "keep.txt",
      "content": "keep"
    }
  ],
  "assertions": [
    {
      "path": "files",
      "includes": "keep.txt"
    },
    {
      "path": "files",
      "includes": "same.lock"
    },
    {
      "path": "files",
      "includes": "same.status.json"
    },
    {
      "path": "files",
      "includes": "same.jsonl"
    }
  ]
}
