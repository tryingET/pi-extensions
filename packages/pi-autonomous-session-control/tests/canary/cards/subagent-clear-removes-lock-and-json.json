{
  "id": "subagent-clear-removes-lock-and-jsonl",
  "title": "subagent-clear must remove tracked .lock + .jsonl session artifacts",
  "target": "subagent_sessions",
  "seedFiles": [
    {
      "name": "same.lock",
      "content": "busy"
    },
    {
      "name": "same.status.json",
      "content": "{\"sessionName\":\"same\",\"status\":\"done\",\"pid\":1,\"ppid\":1,\"createdAt\":\"2026-05-24T00:00:00.000Z\",\"updatedAt\":\"2026-05-24T00:00:00.000Z\",\"sessionKind\":\"subagent\"}"
    },
    {
      "name": "same.jsonl",
      "content": "{}"
    },
    {
      "name": "keep.txt",
      "content": "keep"
    }
  ],
  "assertions": [
    {
      "path": "files",
      "includes": "keep.txt"
    },
    {
      "path": "files",
      "notIncludes": "same.lock"
    },
    {
      "path": "files",
      "notIncludes": "same.status.json"
    },
    {
      "path": "files",
      "notIncludes": "same.jsonl"
    }
  ]
}
