{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-society.local/pi-ontology-workflows/semantic-preflight-v0/prepared-runtime.schema.json",
  "title": "Pi Ontology Workflows Prepared ROCS Runtime v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rocs_commit",
    "files",
    "dependency_lock_digest",
    "interpreter",
    "entrypoint_digest",
    "manifest_digest"
  ],
  "properties": {
    "schema": { "const": "pi-rocs-prepared-runtime-manifest.v0" },
    "rocs_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "size", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$"
          },
          "mode": { "enum": [292, 365, 420, 493] },
          "size": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "dependency_lock_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "interpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]+$"
        },
        "version": { "type": "string", "pattern": "^3\\.12\\.[0-9]+$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "entrypoint_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
