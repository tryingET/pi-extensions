{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "lib/**/*.ts",
    "src/candidatePeerCloseoutArtifacts.ts",
    "src/candidatePeerCloseoutReducer.ts",
    "src/candidatePeerCloseoutSyntheticEffectAdapter.ts"
  ]
}
