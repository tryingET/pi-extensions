{
  "name": "@tryinget/pi-little-helpers",
  "version": "0.5.1",
  "description": "pi extension package for little-helpers workflows in pi",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/pi-extensions.git",
    "directory": "packages/pi-little-helpers"
  },
  "bugs": {
    "url": "https://github.com/tryingET/pi-extensions/issues"
  },
  "homepage": "https://github.com/tryingET/pi-extensions/tree/main/packages/pi-little-helpers",
  "keywords": [
    "pi-package",
    "pi-extension",
    "little-helpers"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "fix": "bash ./scripts/quality-gate.sh fix",
    "lint": "bash ./scripts/quality-gate.sh lint",
    "typecheck": "bash ./scripts/quality-gate.sh typecheck",
    "quality:pre-commit": "bash ./scripts/quality-gate.sh pre-commit",
    "quality:pre-push": "bash ./scripts/quality-gate.sh pre-push",
    "quality:ci": "bash ./scripts/quality-gate.sh ci",
    "check": "npm run quality:ci",
    "test": "npm run quality:ci",
    "docs:list": "bash ./scripts/docs-list.sh",
    "docs:list:workspace": "bash ./scripts/docs-list.sh --workspace --discover",
    "docs:list:json": "bash ./scripts/docs-list.sh --json",
    "release:check": "bash ./scripts/release-check.sh",
    "release:check:quick": "SKIP_PI_SMOKE=1 bash ./scripts/release-check.sh",
    "loop-doctor": "bash -lc 'node --version; npm --version; npm pkg get name version >/dev/null; git status --short -- . || true; exit 0'",
    "loop-verify-fast": "npm run quality:pre-commit",
    "loop-impact-plan": "bash -lc 'echo \"loop-impact-plan: package-local impact planner is coarse; run npm run loop-impact-run for the full package gate.\"; git status --short -- . || true'",
    "loop-impact-run": "npm run check",
    "loop-impact-wide": "npm run check",
    "loop-landing-check": "npm run check"
  },
  "files": [
    "extensions/code-block-picker.ts",
    "extensions/codex-reset.ts",
    "extensions/html-output-browser.ts",
    "extensions/package-update-notify.ts",
    "extensions/session-presence.ts",
    "extensions/sidequest.ts",
    "extensions/stash.ts",
    "lib/codex-reset.ts",
    "lib/package-utils.ts",
    "src/candidatePeerRegistry.ts",
    "src/candidatePeerLifecycleV2.ts",
    "src/candidatePeerLifecycleV2Adoption.ts",
    "src/candidatePeerLifecycleV2Core.ts",
    "src/candidatePeerLifecycleV2Inventory.ts",
    "src/candidatePeerLifecycleV2Review.ts",
    "src/candidatePeerLifecycleV2State.ts",
    "src/candidatePeerLifecycleArchive.ts",
    "src/candidatePeerAdmission.ts",
    "src/candidatePeerAdmissionState.ts",
    "src/candidatePeerLegacyTerminalReconciliation.ts",
    "src/capabilityManifest.ts",
    "src/governedDeepReviewPreflight.ts",
    "src/selfEvolutionEnvelope.ts",
    "src/selfEvolutionVerification.ts",
    "src/toolboxBundle.ts",
    "src/visibleLoop.ts",
    "src/visibleLoopArgs.ts",
    "src/visibleLoopContinuation.ts",
    "src/visibleLoopContinuationClaim.ts",
    "src/visibleLoopDelivery.ts",
    "src/visibleLoopPlan.ts",
    "src/visibleLoopPromptDefaults.ts",
    "src/visibleLoopPromptTemplates.ts",
    "src/visibleLoopProfiles.ts",
    "src/visibleLoopRecovery.ts",
    "src/visibleLoopState.ts",
    "src/visibleLoopTaskBinding.ts",
    "src/visibleLoopTypes.ts",
    "prompts",
    "examples",
    "policy/security-policy.json",
    "policy/engineering-lane.json",
    "scripts/candidate-lifecycle-v2.mjs",
    "scripts/candidate-admission-v2.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./candidate-peer-registry": "./src/candidatePeerRegistry.ts",
    "./candidate-peer-lifecycle-v2": "./src/candidatePeerLifecycleV2.ts",
    "./candidate-peer-lifecycle-archive": "./src/candidatePeerLifecycleArchive.ts",
    "./candidate-peer-admission": "./src/candidatePeerAdmission.ts",
    "./capability-manifest": "./src/capabilityManifest.ts",
    "./toolbox-bundle": "./src/toolboxBundle.ts",
    "./visible-loop": "./src/visibleLoop.ts",
    "./extensions/code-block-picker.ts": "./extensions/code-block-picker.ts",
    "./extensions/codex-reset.ts": "./extensions/codex-reset.ts",
    "./extensions/html-output-browser.ts": "./extensions/html-output-browser.ts",
    "./extensions/package-update-notify.ts": "./extensions/package-update-notify.ts",
    "./extensions/session-presence.ts": "./extensions/session-presence.ts",
    "./extensions/sidequest.ts": "./extensions/sidequest.ts",
    "./extensions/stash.ts": "./extensions/stash.ts",
    "./lib/codex-reset.ts": "./lib/codex-reset.ts",
    "./lib/package-utils.ts": "./lib/package-utils.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./extensions/code-block-picker.ts",
      "./extensions/codex-reset.ts",
      "./extensions/html-output-browser.ts",
      "./extensions/package-update-notify.ts",
      "./extensions/session-presence.ts",
      "./extensions/sidequest.ts",
      "./extensions/stash.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "x-pi-template": {
    "scaffoldMode": "simple-package",
    "workspacePath": "packages/pi-little-helpers",
    "releaseComponent": "pi-little-helpers",
    "releaseConfigMode": "component"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
